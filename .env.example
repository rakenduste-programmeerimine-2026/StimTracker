# Copy to .env.local and fill in from Supabase: "Connect" button, or
# Project Settings -> Data API (URL) and Project Settings -> API Keys (publishable key).
# Never put the secret key (sb_secret_...) here or anywhere in the app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
